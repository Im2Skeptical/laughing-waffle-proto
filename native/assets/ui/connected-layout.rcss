body { width: 100%; height: 100%; margin: 0; }
#safe-content, #play, #shell { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
#shell { display: none; }
#shell.over-game { background-color: #0d100ddb; }
#shell-panel {
  position: absolute; top: 7%; bottom: 7%; left: 15%; right: 15%; overflow: auto;
}
#shell-panel.front-door { background-color: #24271f; border-color: #947b52; }
#shell-panel.slot-book { top: 12%; bottom: auto; max-height: 80%; }
.title-menu { width: 54%; box-sizing: border-box; padding: 8% 24dp 20dp; }
.title-menu h1 { font-size: 40dp; line-height: 1.08; margin-top: 14dp; }
.title-motto { color: #ded0ad; margin-top: 7dp; }
.title-rule { width: 86dp; height: 2dp; background-color: #bb985c; margin: 17dp 0; }
.title-mural {
  position: absolute; top: 0; right: 0; bottom: 0; width: 46%;
  background-color: #523f2d; border-left: 1dp #947b52; pointer-events: none;
}
.mural-border {
  position: absolute; top: 9dp; right: 9dp; bottom: 9dp; left: 9dp;
  border: 1dp #d1b183c9; pointer-events: none;
}
.menu-choice, .slot-action { min-height: 28dp; line-height: 28dp; }
.menu-choice { min-width: 78dp; text-align: center; }
.continue-note { margin: 4dp 0 12dp; }
.seed-row { display: flex; align-items: center; gap: 10dp; margin: 3dp 0 8dp; }
#seed {
  display: block; width: 108dp; padding: 6dp 8dp;
  font-family: Lato; font-size: 15dp; color: #f5e6c6;
  background-color: #191b16; border: 1dp #8f7955;
}
#seed:focus { border-color: #fff0b9; }
.shell-actions { display: flex; gap: 7dp; }
#shell-status { margin-top: 8dp; }
.slot-page { padding: 10dp 14dp; }
.slot-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 5dp; }
.slot-list { border-top: 1dp #66563d; }
.slot {
  display: flex; align-items: center; justify-content: space-between; gap: 9dp;
  padding: 3dp 7dp; border-bottom: 1dp #66563d; background-color: #29281f;
}
.slot.latest-slot { background-color: #333022; border-left: 2dp #cfad71; }
.slot-info { min-width: 0; }
.slot-name { color: #f8e4ba; }
.slot-action { min-width: 61dp; text-align: center; }
#header { position: absolute; left: 2%; right: 2%; top: 2%; bottom: 89%; border-bottom: 1dp #655439; }
#header h1 { line-height: 37dp; }
#header-controls { position: absolute; top: 0; right: 0; display: flex; gap: 6dp; }
#clock { color: #dfc798; padding: 8dp; white-space: nowrap; }

#map { position: absolute; left: 2%; width: 56%; top: 13%; bottom: 28%; border: 1dp #877050;
  overflow: hidden; clip: always; tab-index: auto; }
#map:focus-visible { border-color: #fff0b9; }
#markers { position: absolute; width: 100%; height: 100%; pointer-events: none; }
.marker { position: absolute; font-size: 12dp; color: #f5e6c7;
  background-color: #212420ed; border: 1dp #868578; padding: 1dp 4dp; white-space: nowrap; }
.player { background-color: #253427; border-color: #aab773; }
.crown { background-color: #3e2c20; border-color: #cda074; }
.monster { background-color: #3e2624; border-color: #ce8b7b; }
.marker.selected { border-color: #ffda88; color: #fff2c8; }
.marker.hovered { border-color: #fff0b9; color: #fff2c8; }
.marker.occluded { visibility: hidden; }
#legend { position: absolute; bottom: 7dp; left: 7dp; background-color: #20221cf0;
  padding: 4dp 7dp; border: 1dp #716147; pointer-events: none; white-space: nowrap; }
.player-key { color: #c3d391; }
.crown-key { color: #e4b28b; }
.creep-key { color: #e6a194; }
#map-tools { position: absolute; top: 6dp; right: 6dp; display: flex; gap: 4dp; }
#map-tools button { min-width: 16dp; text-align: center; }

#panel { position: absolute; left: 59.3%; right: 2%; top: 13%; bottom: 28%;
  padding: 11dp; overflow-y: auto; overflow-x: hidden; }
#board { display: flex; gap: 5dp; margin: 10dp 0 9dp; }
#board .card { flex: 1; min-width: 0; height: 102dp; }
#inspector { border-top: 1dp #706045; padding: 8dp 0 3dp; }
#inspector h2 { font-size: 19dp; }
.decision { margin: 4dp 4dp 1dp 0; }
.reform-controls { margin-bottom: 7dp; }
.stats { margin-top: 5dp; padding: 4dp 0; border-bottom: 1dp #4d442f; }
#modal-dimmer { position: absolute; left: 0; top: 0; right: 0; bottom: 26%; background-color: #090c0b91; display: none; }
#reform-dialog { position: absolute; left: 26%; right: 26%; top: 29%; display: none; }
#dialog-copy { margin: 8dp 0; }
#dialog-cost { margin-bottom: 8dp; }
#reform-dialog .decision { margin-top: 8dp; }

#timegraph { position: absolute; left: 2%; right: 2%; top: 74%; bottom: 2%;
  transition: border-color 0.14s quadratic-out, background-color 0.14s quadratic-out; }
#timegraph.preview { background-color: #202b32; border-color: #7ca3b4; }
.reduce-motion #timegraph { transition: none; }
#graph-series, #graph-navigation { position: absolute; top: 5dp; display: flex; gap: 3dp; }
#graph-series { left: 7dp; }
#graph-navigation { right: 7dp; }
#timegraph button { padding: 0 7dp; height: 31dp; line-height: 31dp; white-space: nowrap; }
#graph-scope { width: 102dp; overflow: hidden; text-overflow: ellipsis; text-align: left; color: #f4ce84; }
#graph-navigation button { min-width: 23dp; text-align: center; }
#live { width: 84dp; }
#graph-labels { position: absolute; top: 55dp; bottom: 25dp; left: 9dp; width: 89dp; }
#graph-labels div { height: 50%; overflow: hidden; white-space: nowrap; font-weight: bold; }
#plot { position: absolute; left: 104dp; right: 7dp; top: 42dp; bottom: 26dp; cursor: move; tab-index: auto; }
#plot:focus-visible { border: 1dp #fff0b9; }
#plot.unavailable { cursor: default; tab-index: none; }
#axis-start, #axis-end, #graph-status, #graph-comparison { position: absolute; bottom: 5dp; white-space: nowrap; }
#axis-start { left: 9dp; }
#axis-end { right: 237dp; }
#graph-overview { position: absolute; bottom: 1dp; height: 22dp; left: 104dp; right: 340dp; cursor: move; tab-index: auto; }
#graph-overview:focus-visible { border: 1dp #fff0b9; }
#graph-status { right: 8dp; }
#graph-status.terminal { color: #f3ae99; }
#timegraph.preview #graph-status { color: #c6e9f5; }
#graph-comparison { display: none; right: 7dp; bottom: 100%; background-color: #26231f;
  color: #cec0ad; border-left: 2dp #a89585; padding: 1dp 5dp; pointer-events: none; }
#readout { position: absolute; display: none; bottom: 100%; width: 238dp; }
#opening { position: absolute; left: 26%; right: 26%; top: 34%; text-align: center; }
#opening p, #opening .progress { margin-top: 9dp; }
#notice { position: absolute; display: none; right: 2%; bottom: 28%; width: 275dp; }
#help { position: absolute; display: none; width: 218dp; }
#help.crest-help { width: 304dp; }

.touch-screen button:not(.card) { min-height: 32dp; }
.touch-screen #map-tools button { min-width: 22dp; }
.touch-screen #map, .touch-screen #panel { top: 15%; }
.touch-screen #timegraph button { min-height: 31dp; }

@media (max-width: 820px) {
  #shell-panel { left: 8%; right: 8%; top: 4%; bottom: 4%; }
  #shell-panel.slot-book { top: 7%; max-height: 89%; }
  .title-menu { padding: 11dp 18dp; }
  .title-menu h1 { font-size: 32dp; }
  #map { width: 51%; }
  #panel { left: 54.5%; padding: 8dp; }
  #board { gap: 3dp; margin: 6dp 0; }
  #board .card { height: 86dp; }
  #reform-dialog, #opening { left: 20%; right: 20%; }
  #legend { font-size: 12dp; }
  #timegraph { top: 70%; }
  #map, #panel, #play #life-screen, #notice { bottom: 32%; }
  #modal-dimmer { bottom: 30%; }
  #graph-scope { width: 88dp; }
  #timegraph button { padding: 0 5dp; }
  #graph-navigation button { min-width: 21dp; }
  #live { width: 75dp; }
  #graph-comparison { right: 9dp; }
}
/* Life Map shares the atlas frame and leaves the timegraph visible. */
#life-screen {
  display: none; position: absolute; top: 13%; bottom: 28%; left: 2%; right: 2%;
}
.touch-screen #life-screen { top: 15%; }
#life-chart {
  position: absolute; left: 0; top: 0; bottom: 0; width: 64%;
  border: 1dp #877050; overflow: hidden; clip: always;
}
#life-chart.candidates { background-color: #20241d; }
#life-inspector {
  position: absolute; top: 0; bottom: 0; left: 65.2%; right: 0;
  overflow-y: auto; overflow-x: hidden; padding: 9dp;
}
.life-chart-title { position: absolute; left: 9dp; top: 6dp; color: #f0d69f; }
.life-legend {
  position: absolute; bottom: 7dp; left: 8dp; right: 8dp;
  font-size: 12dp; color: #d5c5a7; white-space: nowrap;
}
.life-node {
  position: absolute; width: 31dp; height: 31dp; margin: -15.5dp 0 0 -15.5dp;
  text-align: center; padding: 0; line-height: 31dp; border-radius: 8dp;
  font-size: 12dp; color: #c4baa5; background-color: #2c2f27;
}
.life-node.available { color: #1d2118; background-color: #c7d592; border-color: #e9eeb8; }
.life-node.current { color: #231c13; background-color: #dcb668; border-color: #ffe1a3; }
.life-node.completed { color: #d8e6ed; background-color: #374b52; border-color: #8fadb9; }
.life-node.chosen { border: 2dp #fff5ce; }
.life-node:hover, .life-node:focus-visible { color: #fff2c8; background-color: #5c5037; }
.life-candidates { position: absolute; top: 34dp; left: 7dp; right: 7dp; bottom: 7dp;
  display: flex; align-items: stretch; justify-content: center; gap: 9dp; }
.life-candidate { flex: 1; min-width: 0; max-width: 240dp; padding: 6dp; text-align: center; }
.life-portrait { height: 49%; margin: 0 auto 4dp; width: 88%; }
.life-candidate h2 { font-size: 18dp; }
.life-candidate p { font-size: 12dp; }
.life-candidate .quiet { margin: 2dp 0; }
.life-brief { border-bottom: 1dp #66563d; padding-bottom: 5dp; margin-bottom: 5dp; }
.life-choice { width: 100%; box-sizing: border-box; display: block; min-height: 34dp;
  white-space: normal; margin: 4dp 0; text-align: left; }
.life-choice.chosen { border-color: #efcd83; background-color: #443e29; }
.life-choice p { font-size: 12dp; }
.life-choice-art { width: 33dp; height: 33dp; float: right; }
.life-choice .blocked-reason { color: #edb6a3; }
.life-choice.blocked { border-color: #675c4d; background-color: #292821; }
.life-entry { margin: 3dp 0; font-size: 12dp; }
.life-state { margin: 3dp 0 5dp; }
.life-summary { font-size: 12dp; color: #e4c88b; }
.life-progress { margin: 5dp 0; }
@media (max-width: 820px) {
  #life-chart { width: 61%; }
  #life-inspector { left: 62.2%; padding: 6dp; }
  #life-inspector h2 { font-size: 16dp; }
  .life-node { width: 26dp; height: 28dp; margin: -14dp 0 0 -13dp; line-height: 28dp; }
  .life-candidates { top: 28dp; gap: 5dp; }
  .life-portrait { height: 38%; }
  .life-legend, .life-entry { font-size: 13dp; }
  .life-choice p, .life-candidate p, .life-summary { font-size: 14dp; }
  .life-choice { min-height: 40dp; }
  .life-node { font-size: 13dp; }
}
#life-chart.shop-floor { background-color: #20241d; overflow-y: auto; overflow-x: hidden; box-sizing: border-box; padding: 8dp; }
.shop-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 6dp; margin-bottom: 4dp; }
.shop-tabs, .shop-market-label, .shop-draft-tools { display: flex; gap: 4dp; align-items: center; }
.shop-market-label { justify-content: space-between; min-height: 26dp; margin: 4dp 0; }
.shop-tabs .chosen { color: #fff2c8; border-color: #efcd83; background-color: #51432c; }
.shop-placement-mode { margin-top: 3dp; }
.shop-placement-mode .button { min-height: 23dp; }
.shop-total { font-size: 16dp; color: #f4d69b; margin: 4dp 0; }
.shop-draft-tools { flex-wrap: wrap; }
.shop-grid { display: flex; flex-wrap: wrap; gap: 5dp; }
.shop-offer { width: 48%; min-height: 48dp; box-sizing: border-box; display: flex; align-items: center;
  text-align: left; white-space: normal; padding: 4dp; gap: 6dp; }
.shop-offer.chosen, .shop-cell.chosen { border-color: #efcd83; background-color: #51432c; }
.shop-offer.blocked { border-color: #695347; }
.shop-art { width: 31dp; height: 40dp; flex: 0 0 31dp; }
.shop-offer-text { min-width: 0; font-size: 13dp; }
.shop-offer-text p { font-size: 11dp; }
.blocked-reason { color: #edb6a3; }
.shop-strip { display: flex; gap: 3dp; margin: 4dp 0; }
.shop-cell { min-width: 0; flex: 1; padding: 3dp; text-align: center; min-height: 57dp; white-space: normal; overflow: hidden; }
.shop-cell .shop-art { width: 32dp; height: 28dp; margin: 1dp auto; }
.shop-cell p { line-height: 1.1; font-size: 12dp; }
.shop-cell-caption { color: #e5c793; font-size: 11dp; }
.shop-link { color: #e5c793; font-size: 18dp; }
.shop-cell.occupied { color: #bfa783; background-color: #3e3426; }
.shop-cell.chosen { color: #fff4cb; background-color: #685038; }
.shop-cell.locked { color: #acaa9d; background-color: #292b23; }
.shop-cell.staged { border-color: #c59557; }
.shop-pending-mark { color: #ffd99a; font-size: 10dp; }
.shop-strip .valid-target, .shop-floor .valid-target { border-color: #a6bd78; background-color: #293727; }
.shop-strip .invalid-target, .shop-floor .invalid-target { border-color: #986852; background-color: #372922; }
.shop-floor .drop-hover { border-width: 2dp; color: #fff1d0; }
.shop-floor .valid-target.drop-hover { border-color: #d9eca1; background-color: #445334; }
.shop-floor .invalid-target.drop-hover { border-color: #efb19b; }
.shop-target-preview { color: #e4c88b; font-size: 12dp; }
.shop-discard { display: flex; flex-wrap: wrap; align-items: center; gap: 4dp; }
.shop-receipt { display: flex; align-items: center; justify-content: space-between; gap: 5dp; margin: 4dp 0; }
@media (max-width: 820px) {
  .shop-heading { flex-wrap: wrap; }
  .shop-heading h2 { font-size: 17dp; }
  .shop-offer { min-height: 52dp; }
  .shop-offer-text p { font-size: 13dp; }
  .shop-cell { min-height: 63dp; }
  .shop-cell .shop-art { width: 25dp; height: 22dp; }
  .shop-cell p { font-size: 11dp; }
}
