<rml>
<head>
<title>Laughing Waffle</title>
<!-- interaction styles -->
<!-- atlas styles -->
</head>
<body data-model="connected">
<div id="safe-content">
<div id="play">
<div id="header">
  <h1 id="screen-title">Regional Map</h1>
  <div id="header-controls">
    <div id="clock">{{clock}}</div>
    <button id="run-advance" class="button primary" data-op="run-advance"
      data-help="Commit time from Live before appointing a Vassal.">Advance Live</button>
    <button id="motion" class="toggle" data-op="motion" data-help="Reduce camera and interface motion.">Motion On</button>
    <button id="life-toggle" class="tab" data-op="life-toggle" data-help="Open the Vassal Life Map.">Life Map</button>
    <button id="save-game" class="button" data-op="save" data-help="Save the current run to a manual slot.">Save</button>
    <button id="title-game" class="button" data-op="title" data-help="Return to the title screen.">Title</button>
  </div>
</div>
<div id="run-strip" role="group" aria-label="Civilization survival and viewed time">
  <div class="run-reading" id="run-calendar"><div id="run-year"></div><div id="run-season" class="quiet"></div></div>
  <div class="run-reading" id="run-tenures"><div id="run-tenure-count"></div><div id="run-best" class="quiet"></div></div>
  <button class="run-reading" id="run-outcome" data-op="run-outcome" aria-haspopup="dialog">
    <span id="run-cause"></span><span id="run-loss-year" class="quiet"></span>
  </button>
  <div class="run-reading" id="run-mode"><div id="run-viewed"></div><div id="run-live-time" class="quiet"></div></div>
  <div class="run-reading" id="run-range"><div id="run-bounds"></div><div id="run-transport-state" class="quiet"></div></div>
  <div id="run-controls" role="group" aria-label="Read-only time playback">
    <button id="run-rewind-fast" class="toggle" data-op="run-speed" data-id="-256" aria-label="Rewind at 256 times speed" data-help="Fast rewind through the timeline.">−256×</button>
    <button id="run-rewind" class="toggle" data-op="run-speed" data-id="-1" aria-label="Rewind at normal speed" data-help="Rewind one game second per second.">−1×</button>
    <button id="run-hold" class="toggle" data-op="run-speed" data-id="0" data-help="Hold the viewed second.">Hold</button>
    <button id="run-forward" class="toggle" data-op="run-speed" data-id="1" aria-label="Play at normal speed" data-help="Play one game second per second.">+1×</button>
    <button id="run-forward-fast" class="toggle" data-op="run-speed" data-id="256" aria-label="Play at 256 times speed" data-help="Fast forward through the timeline.">+256×</button>
    <button id="run-follow" class="toggle" data-op="run-follow" data-help="Follow the latest available forecast second.">Follow</button>
  </div>
</div>
<div id="map" role="group" aria-label="Regional map" data-help="Select a region. Drag to pan, or use the arrow keys to select a settlement.">
  <div id="markers"></div>
  <div id="map-tools">
    <button class="button" data-op="zoom-out" data-help="Zoom out." aria-label="Zoom out">−</button>
    <button class="button" data-op="zoom-in" data-help="Zoom in." aria-label="Zoom in">+</button>
  </div>
  <div id="legend" class="quiet"><span class="player-key">Your holdings</span> &nbsp; <span class="crown-key">Crown</span> &nbsp; Unheld &nbsp; <span class="creep-key">Creep</span></div>
</div>
<div id="panel" class="panel"><div id="panel-content"></div></div>
<div id="life-screen" role="group" aria-label="Vassal Life Map">
  <div id="life-chart"></div>
  <div id="life-inspector" class="panel"></div>
</div>
<div id="timegraph" class="panel">
  <div id="graph-series">
    <button id="graph-scope" class="tab" data-op="graph-scope" data-help="Switch between all your holdings and the selected settlement.">Civilization</button>
    <button id="graph-people" class="tab on" data-op="graph-people" data-help="Population and Food.">People</button>
    <button id="graph-belief" class="tab" data-op="graph-belief" data-help="Population-weighted Faith and Happiness.">Belief</button>
    <button id="graph-stock" class="tab" data-op="graph-stock" data-help="Food and Currency Stock.">Stock</button>
    <button id="graph-realm" class="tab" data-op="graph-realm" data-help="Civilization Prestige and controlled regions.">Realm</button>
    <button id="graph-chaos" class="tab" data-op="graph-chaos" data-help="Civilization Chaos and Monster count.">Chaos</button>
  </div>
  <div id="graph-navigation">
    <button id="graph-prev" class="button" data-op="graph-prev" aria-label="Previous event" data-help="Previous event (Page Up).">‹ Event</button>
    <button id="graph-next" class="button" data-op="graph-next" aria-label="Next event" data-help="Next event (Page Down).">Event ›</button>
    <button id="graph-out" class="button" data-op="graph-out" aria-label="Zoom time out" data-help="Zoom time out. Drag the overview to pan.">−</button>
    <button id="graph-in" class="button" data-op="graph-in" aria-label="Zoom time in" data-help="Zoom time in. Scroll over the chart to zoom around the pointer.">+</button>
    <button id="live" class="tab on" data-op="live" data-help="Return to committed time (Home).">Live</button>
  </div>
  <div id="graph-labels" class="quiet"><div id="graph-label-one"></div><div id="graph-label-two"></div></div>
  <div id="plot" role="slider" aria-label="Forecast time" data-help="Arrow keys step one second. Hold Shift for a moon, Ctrl for a season, or Alt for a year."></div>
  <div id="axis-start" class="quiet"></div>
  <div id="graph-overview" role="group" aria-label="Forecast overview" data-help="Drag to pan the forecast."></div>
  <div id="axis-end" class="quiet"></div>
  <div id="graph-status" class="quiet">{{status}}</div>
  <div id="graph-comparison" class="quiet"></div>
  <div id="readout" class="tooltip"></div>
</div>
<div id="opening" class="dialog">
  <h2 id="loading-title">Preparing the forecast</h2>
  <p id="loading-status" class="quiet">{{status}}</p>
  <div class="progress" role="progressbar"><div class="progress-fill" data-style-width="progress"></div></div>
</div>
</div>
<div id="shell" class="shell-overlay"><div id="shell-panel"></div></div>
<div id="outcome-overlay">
  <div id="outcome-dialog" class="dialog" role="dialog" aria-modal="true" aria-labelledby="outcome-title">
    <div id="outcome-year" class="gold"></div>
    <h2 id="outcome-title"></h2>
    <h3 id="outcome-cause"></h3>
    <p id="outcome-copy"></p>
    <p id="outcome-guidance" class="quiet"></p>
    <div id="outcome-actions">
      <button id="outcome-browse" class="button" data-op="run-browse">Browse timeline</button>
      <button id="outcome-new" class="button primary" data-op="run-new">New Game</button>
    </div>
  </div>
</div>
<div id="modal-dimmer"></div>
<div id="reform-dialog" class="dialog" role="dialog" aria-labelledby="dialog-title">
  <h2 id="dialog-title">Confirm Practice Reform</h2>
  <p id="dialog-copy"></p>
  <p id="dialog-cost" class="gold"></p>
  <button id="dialog-back" class="button decision" data-op="back">Back</button>
  <button id="dialog-confirm" class="button decision primary" data-op="confirm">Spend time and reform</button>
</div>
<div id="notice" class="toast" role="status"></div>
<div id="help" class="tooltip"></div>
</div>
</body>
</rml>
