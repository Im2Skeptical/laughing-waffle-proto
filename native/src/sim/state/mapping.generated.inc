HotState Mapping<HotState>::read(Import& codec, const browser::GameState& source, const std::string& path)
{
    HotState result{};
    result.gameStateSchemaVersion = codec.read<browser::Version52>(source.gameStateSchemaVersion, property_path(path, "gameStateSchemaVersion"));
    result.phase = codec.read<browser::Phase>(source.phase, property_path(path, "phase"));
    result.turn = codec.read<double>(source.turn, property_path(path, "turn"));
    result.seasons = codec.read<Range<SeasonId>>(source.seasons, property_path(path, "seasons"));
    result.currentSeasonIndex = codec.read<double>(source.currentSeasonIndex, property_path(path, "currentSeasonIndex"));
    result.year = codec.read<double>(source.year, property_path(path, "year"));
    result.simStepIndex = codec.read<double>(source.simStepIndex, property_path(path, "simStepIndex"));
    result.tSec = codec.read<double>(source.tSec, property_path(path, "tSec"));
    result.seasonTimeRemaining = codec.read<double>(source.seasonTimeRemaining, property_path(path, "seasonTimeRemaining"));
    result.seasonDurationSec = codec.read<double>(source.seasonDurationSec, property_path(path, "seasonDurationSec"));
    result.simTime = codec.read<double>(source.simTime, property_path(path, "simTime"));
    result.seasonClockSec = codec.read<double>(source.seasonClockSec, property_path(path, "seasonClockSec"));
    result.paused = codec.read<bool>(source.paused, property_path(path, "paused"));
    result.actionPoints = codec.read<double>(source.actionPoints, property_path(path, "actionPoints"));
    result.actionPointCap = codec.read<double>(source.actionPointCap, property_path(path, "actionPointCap"));
    result.apCapOverride = codec.read<std::optional<ApCapOverride>>(source.apCapOverride, property_path(path, "apCapOverride"));
    result.variantFlags = codec.read<VariantFlags>(source.variantFlags, property_path(path, "variantFlags"));
    result.world = codec.read<World>(source.world, property_path(path, "world"));
    result.civilization = codec.read<Civilization>(source.civilization, property_path(path, "civilization"));
    result.gameEventFeed = codec.read<HistoryRef<LegacyFeedEntry, 0, GameState_gameEventFeed>>(source.gameEventFeed, property_path(path, "gameEventFeed"));
    result.nextGameEventFeedId = codec.read<double>(source.nextGameEventFeedId, property_path(path, "nextGameEventFeedId"));
    result.skillProgressionDefs = codec.read<std::optional<ColdRef<core::json::Value, GameState_skillProgressionDefs>>>(source.skillProgressionDefs, property_path(path, "skillProgressionDefs"));
    result.skillRuntime = codec.read<SkillRuntime>(source.skillRuntime, property_path(path, "skillRuntime"));
    result.persistentKnowledge = codec.read<ColdRef<browser::PersistentKnowledge, GameState_persistentKnowledge>>(source.persistentKnowledge, property_path(path, "persistentKnowledge"));
    result.rng = codec.read<core::RngState>(source.rng, property_path(path, "rng"));
    result.rulesetId = codec.read<std::optional<browser::FullMapRuleset>>(source.rulesetId, property_path(path, "rulesetId"));
    result.runStatus = codec.read<std::optional<RunStatus>>(source.runStatus, property_path(path, "runStatus"));
    return result;
}

browser::GameState Mapping<HotState>::write(const Export& codec, const HotState& source)
{
    browser::GameState result{};
    codec.write(result.gameStateSchemaVersion, source.gameStateSchemaVersion);
    codec.write(result.phase, source.phase);
    codec.write(result.turn, source.turn);
    codec.write(result.seasons, source.seasons);
    codec.write(result.currentSeasonIndex, source.currentSeasonIndex);
    codec.write(result.year, source.year);
    codec.write(result.simStepIndex, source.simStepIndex);
    codec.write(result.tSec, source.tSec);
    codec.write(result.seasonTimeRemaining, source.seasonTimeRemaining);
    codec.write(result.seasonDurationSec, source.seasonDurationSec);
    codec.write(result.simTime, source.simTime);
    codec.write(result.seasonClockSec, source.seasonClockSec);
    codec.write(result.paused, source.paused);
    codec.write(result.actionPoints, source.actionPoints);
    codec.write(result.actionPointCap, source.actionPointCap);
    codec.write(result.apCapOverride, source.apCapOverride);
    codec.write(result.variantFlags, source.variantFlags);
    result.gameConfig = codec.state.content->config;
    codec.write(result.world, source.world);
    codec.write(result.civilization, source.civilization);
    codec.write(result.gameEventFeed, source.gameEventFeed);
    codec.write(result.nextGameEventFeedId, source.nextGameEventFeedId);
    codec.write(result.skillProgressionDefs, source.skillProgressionDefs);
    codec.write(result.skillRuntime, source.skillRuntime);
    codec.write(result.persistentKnowledge, source.persistentKnowledge);
    codec.write(result.rng, source.rng);
    codec.write(result.rulesetId, source.rulesetId);
    codec.write(result.runStatus, source.runStatus);
    return result;
}

void Mapping<HotState>::digest(Digest& codec, const HotState& source)
{
    codec.fields("gameStateSchemaVersion", source.gameStateSchemaVersion);
    codec.fields("phase", source.phase);
    codec.fields("turn", source.turn);
    codec.fields("seasons", source.seasons);
    codec.fields("currentSeasonIndex", source.currentSeasonIndex);
