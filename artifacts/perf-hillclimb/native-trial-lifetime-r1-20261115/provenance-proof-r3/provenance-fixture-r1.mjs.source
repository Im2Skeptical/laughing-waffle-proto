// COHERENT VIRTUAL host/config/journal source schema. NEVER native evidence.
import fs from 'node:fs';import path from 'node:path';import {fileURLToPath} from 'node:url';import {digest,hostCommandLine} from './check-trial-provenance.mjs';
const dir=path.dirname(fileURLToPath(import.meta.url));const refs=JSON.parse(fs.readFileSync(path.join(dir,'provenance-proof-r3','managed-fingerprint-reference.json'),'utf8'));
export const encode=v=>Buffer.from(JSON.stringify(v));export const copy=v=>structuredClone(v);
const H=v=>'0x'+BigInt(v).toString(16).padStart(16,'0');const call=Phase=>({Phase,Result:true,ErrorValid:false,RawLastError:121,Error:null});
const close=origin=>({origin,state:'NATIVE_CLOSE_SUCCEEDED',detail:null,nativeCalled:true,result:true,rawLastError:121,errorValid:false,error:null});
const release=(Origin,Handle)=>({Origin,Handle,State:'NATIVE_CLOSE_SUCCEEDED',Detail:null,NativeCalled:true,Confirmed:true,RawLastError:121,ErrorValid:false,Error:null});
export function makeProvenanceFixture(mode='reuse'){
  const ref=refs.find(x=>x.mode===mode);if(!ref?.config||!ref.fingerprint)throw new Error('valid pure C# fingerprint reference absent');const c=copy(ref.config),configBytes=encode(c),sha='b'.repeat(64),manifest='c'.repeat(64);
  const expected={boundary:'CALLER_MUST_VERIFY_RUNTIME_FILES_SOURCE_ADMISSION_AND_BATCH',slotId:c.Id,mode:c.Mode,runRoot:c.RunRoot,configFile:path.win32.join(c.ArtifactRoot,`virtual-config-${mode}.json`),configFileSha256:digest(configBytes),configSha256:ref.fingerprint,admissionFile:path.win32.join(c.ArtifactRoot,`virtual-admission-${mode}.json`),reviewSha256:sha,manifestSha256:manifest};
  const admission={schema:1,kind:'SOURCE_ONLY_TWO_SYNTHETIC_CELLS',verdict:'SOURCE_ACCEPTED',auditor:'independent-fixture-auditor',builder:'fixture-builder',slotId:c.Id,mode:c.Mode,configSha256:ref.fingerprint,observerSha256:c.ObserverSha256,targetSha256:c.ExecutableSha256,reviewFile:path.win32.join(c.ArtifactRoot,'virtual-review.md'),reviewSha256:sha,manifestFile:path.win32.join(c.ArtifactRoot,'virtual-manifest.json'),manifestSha256:manifest,notAfterUtc:'2026-11-16T01:45:00Z'};
  const admissionBytes=encode(admission);expected.admissionSha256=digest(admissionBytes);const parent={Pid:42,HandleOwnerPid:99,CreatedFileTimeHex:H(134087812345678901n),Image:c.HostExecutable,ImageSha256:c.HostSha256,OwnedHandle:H(4096)},local={...parent,HandleOwnerPid:42};
  const launch={schema:1,slotId:c.Id,mode:c.Mode,configSha256:ref.fingerprint,hostPid:42,hostCreatedFileTimeHex:parent.CreatedFileTimeHex,hostImage:parent.Image,hostImageSha256:parent.ImageSha256,hostHandleOwnerPid:99,hostOwnedHandle:parent.OwnedHandle,commandLine:hostCommandLine(c,expected),cwd:c.RunRoot,configFileSha256:expected.configFileSha256,admissionSha256:expected.admissionSha256,resumed:false};
  const hostPin=c.Inputs.find(p=>p.Path===c.HostExecutable),selfCalls=[{phase:'host.self.DuplicateHandle',sourcePseudoHandle:H(0xffffffffffffffffn),produced:local.OwnedHandle,call:call('DuplicateHandle'),inherit:false,sameAccess:true},{phase:'host.self.GetProcessId',pid:42,currentPid:42,rawLastError:121,errorValid:false},{phase:'host.self.GetProcessTimes',createdFileTimeHex:local.CreatedFileTimeHex,call:call('GetProcessTimes')},{phase:'host.self.QueryFullProcessImageNameW',image:local.Image,returnedChars:local.Image.length,call:call('QueryFullProcessImageNameW')},{phase:'host.self.image-file-pin',path:hostPin.Path,sha256:hostPin.Sha256,bytes:String(hostPin.Bytes)}];
  const self={identity:local,calls:selfCalls,close:{origin:'host.self.GetCurrentProcess.independent-duplicate',state:'NATIVE_CLOSE_PENDING',detail:null,nativeCalled:false,result:null,rawLastError:null,errorValid:false,error:null},raw:local.OwnedHandle};
  const provenance={configSha256:ref.fingerprint,configFile:expected.configFile,configFileSha256:expected.configFileSha256,admissionFile:expected.admissionFile,admissionSha256:expected.admissionSha256,reviewFile:admission.reviewFile,reviewSha256:admission.reviewSha256,manifestFile:admission.manifestFile,manifestSha256:admission.manifestSha256,inputPins:c.Inputs.map(p=>({...p,Bytes:String(p.Bytes)})).sort((a,b)=>a.Path.toUpperCase()<b.Path.toUpperCase()?-1:1),loader:{sha256:c.NtdllSha256,contractSha256:c.LoaderContractSha256},selfHost:local,supervisorHostLaunch:launch,supervisorHostLaunchSha256:digest(encode(launch)),actualHostCommandLine:launch.commandLine,actualHostCwd:c.RunRoot,observerLibrary:c.ObserverLibrary,observerSha256:c.ObserverSha256,creatingOSThread:102,selfCapture:self};
  const start={schema:1,slotId:c.Id,mode:c.Mode,provenance};const root={Schema:1,SlotId:c.Id,Mode:c.Mode,ConfigSha256:ref.fingerprint,ExecutableSha256:c.ExecutableSha256,RootImage:c.Executable,RootCreatedFileTimeHex:H(1000),ExecutableBytes:c.ExecutableBytes,RootPid:100,PrimaryTid:101,CreatingThread:102,AssignedBeforeResume:true,Resumed:false,Host:local};
  const end={schema:1,slotId:c.Id,mode:c.Mode,configSha256:ref.fingerprint,intendedExitCode:0,hostExitRequired:false,self:{...copy(self),close:close('host.self.GetCurrentProcess.independent-duplicate')},selfRelease:release('host.self.GetCurrentProcess.independent-duplicate',local.OwnedHandle),entryErrors:[],captureErrors:[],scope:'VIRTUAL fixture, not physical exit proof'};
  const calls=[{phase:'host.CreateProcessW',result:true,rawLastError:121,errorValid:false,error:null,debugFlags:false,suspended:true,hidden:true,handleWhitelist:3,commandLine:launch.commandLine,cwd:c.RunRoot},{phase:'host.DuplicateHandle',source:H(256),produced:parent.OwnedHandle,result:true,rawLastError:121,errorValid:false,error:null,activeAlias:false,inherit:false,sameAccess:true},{phase:'host.GetProcessId',handle:parent.OwnedHandle,pid:42,rawLastError:121,errorValid:false},{phase:'host.GetProcessTimes',call:call('GetProcessTimes'),createdFileTimeHex:parent.CreatedFileTimeHex},{phase:'host.QueryFullProcessImageNameW',call:call('QueryFullProcessImageNameW'),image:parent.Image,returnedChars:parent.Image.length},{phase:'host.image-file-pin',path:hostPin.Path,sha256:hostPin.Sha256,bytes:String(hostPin.Bytes)},{phase:'host.identity',pid:42,createdFileTimeHex:parent.CreatedFileTimeHex,image:parent.Image,times:call('GetProcessTimes'),imageQuery:call('QueryFullProcessImageNameW'),pidRawLastError:121},{phase:'host.primary-thread-identity',handle:H(260),tid:45,pid:42,tidRawLastError:121,tidErrorValid:false,pidRawLastError:121,pidErrorValid:false},close('host.stdin.NUL'),close('host.output.NUL'),close('host.output.NUL'),{phase:'host.ResumeThread',previous:1,rawLastError:121,errorValid:false}];
  const wait={NativeCalled:true,OwnerHeld:true,IdentityVerified:true,ErrorValid:false,Handle:parent.OwnedHandle,CreatedFileTimeHex:parent.CreatedFileTimeHex,Image:parent.Image,Pid:42,HandleOwnerPid:99,Status:0,RequestedMs:100,RawLastError:121,Error:null,ExitCodeCall:call('host.GetExitCodeProcess'),ExitCode:0};
  const policy={NaturalExit:true,ForcedStop:false,ExitConfirmed:true,DeadlineExceeded:false,ExitCode:0,Termination:null,Release:release('host.CreateProcess.independent-wait-duplicate',parent.OwnedHandle),WorkStartedMs:'0',WorkStoppedMs:'1000',StopStartedMs:'0',StopStoppedMs:'0',Waits:[wait],Errors:[]};
  const hostEvidence={identity:parent,primaryTid:45,creationProcess:H(256),creationThread:H(260),waitDuplicate:parent.OwnedHandle,created:true,verified:true,resumed:true,released:true,calls,setupFailure:null,processOriginalClose:close('host.CreateProcess.returned.process'),threadOriginalClose:close('host.CreateProcess.returned.thread'),waitDuplicateClose:close('host.CreateProcess.independent-wait-duplicate')};
  const supervisor={schema:1,kind:'SYNTHETIC_TRIAL_SUPERVISOR_OUTCOME',slotId:c.Id,mode:c.Mode,configSha256:ref.fingerprint,configFileSha256:expected.configFileSha256,admissionSha256:expected.admissionSha256,hostCreated:true,hostExitConfirmed:true,hardBlockNativeOwnership:false,hostPolicy:policy,hostEvidence,errors:[],completeCellAcceptance:false,scope:'VIRTUAL not actual cell'};
  const report={provenance:copy(provenance),controller:{startup:{RootPid:100,PrimaryTid:101,CreatingThread:102,CreatedFileTimeHex:H(1000)}},containmentCompleteClaim:true};
  const values={admission,launch,start,root,end,supervisor,report};const original={configBytes,admissionBytes,hostLaunchBytes:encode(launch),hostStartBytes:encode(start),rootLaunchBytes:encode(root),hostEndBytes:encode(end),supervisorBytes:encode(supervisor),reportBytes:encode(report),markers:new Map(['attempt.marker','host-attempt.marker','host-entry.marker'].map(n=>[n,Buffer.from('exclusive-control-reservation\n')]))};return {kind:'VIRTUAL_PROVENANCE_ONLY_NOT_NATIVE',c,expected,values,original};
}
export function serializeProvenance(f){f.original.admissionBytes=encode(f.values.admission);f.original.hostLaunchBytes=encode(f.values.launch);f.original.hostStartBytes=encode(f.values.start);f.original.rootLaunchBytes=encode(f.values.root);f.original.hostEndBytes=encode(f.values.end);f.original.supervisorBytes=encode(f.values.supervisor);f.original.reportBytes=encode(f.values.report);}
