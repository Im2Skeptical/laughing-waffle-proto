import fs from 'node:fs';import path from 'node:path';import {fileURLToPath} from 'node:url';import {digest,inspectTrialProvenance,reconstructConfig,hostCommandLine} from './check-trial-provenance.mjs';import {makeProvenanceFixture,serializeProvenance,encode} from './provenance-fixture-r1.mjs';
const root=path.dirname(fileURLToPath(import.meta.url)),out=path.join(root,'provenance-proof-r3','checker-proof-r1.json');if(fs.existsSync(out))throw new Error('Fresh proof identity required');const checks=[];let accepts=0,rejects=0,error=null;
function yes(name,v){if(!v)throw new Error('FAIL:'+name);checks.push(name);}
function positive(name,f){const r=inspectTrialProvenance(f.original,f.expected);yes(name,r.completeCellAcceptance===false&&r.sourceRuntimeFilesAndBatchVerified===false);accepts++;return r;}
function negative(name,change){const f=makeProvenanceFixture();change(f);serializeProvenance(f);let caught=false;try{inspectTrialProvenance(f.original,f.expected);}catch{caught=true;}yes(name,caught);rejects++;}
try{
  for(const mode of ['reuse','fail-after-first']){const f=makeProvenanceFixture(mode);yes('independent-JS-vs-pure-Csharp-fingerprint-'+mode,reconstructConfig(f.original.configBytes).configSha256===f.expected.configSha256);positive('coherent-VIRTUAL-provenance-'+mode,f);}
  const cases={
    'wrong-config-file-hash':f=>f.expected.configFileSha256='f'.repeat(64),'wrong-canonical-fingerprint':f=>f.expected.configSha256='f'.repeat(64),'wrong-admission-file-hash':f=>f.expected.admissionSha256='f'.repeat(64),'wrong-source-review-hash':f=>f.expected.reviewSha256='f'.repeat(64),'wrong-manifest-hash':f=>f.expected.manifestSha256='f'.repeat(64),
    'root-published-after-resume':f=>f.values.root.Resumed=true,'root-not-assigned':f=>f.values.root.AssignedBeforeResume=false,'root-wrong-generation':f=>f.values.root.RootCreatedFileTimeHex='0x0000000000009999','root-wrong-creating-thread':f=>f.values.root.CreatingThread++,'root-foreign-image':f=>f.values.root.RootImage='C:\\other.exe','root-host-parent-handle-context':f=>f.values.root.Host.HandleOwnerPid=99,
    'parent-wait-timeout-with-success-flags':f=>{f.values.supervisor.hostPolicy.Waits[0].Status=258;f.values.supervisor.hostPolicy.Waits[0].ExitCode=null;f.values.supervisor.hostPolicy.Waits[0].ExitCodeCall=null;},'parent-native-exit23-with-code0-claim':f=>f.values.supervisor.hostPolicy.Waits[0].ExitCode=23,'parent-foreign-handle':f=>f.values.supervisor.hostPolicy.Waits[0].Handle='0x0000000000009999','parent-wrong-handle-owner':f=>f.values.supervisor.hostPolicy.Waits[0].HandleOwnerPid=42,'parent-wrong-generation':f=>f.values.supervisor.hostPolicy.Waits[0].CreatedFileTimeHex='0x0000000000009999','parent-unheld-wait':f=>f.values.supervisor.hostPolicy.Waits[0].OwnerHeld=false,'parent-failed-exitcode-call':f=>f.values.supervisor.hostPolicy.Waits[0].ExitCodeCall.Result=false,'parent-wait-error-valid-on-success':f=>f.values.supervisor.hostPolicy.Waits[0].ErrorValid=true,
    'host-deadline-exact-with-success-flags':f=>f.values.supervisor.hostPolicy.WorkStoppedMs='45000','host-reset-origin':f=>f.values.supervisor.hostPolicy.WorkStartedMs='1000','host-forced-stop':f=>f.values.supervisor.hostPolicy.Termination={Result:true},'host-wait-cap':f=>f.values.supervisor.hostPolicy.Waits[0].RequestedMs=101,'host-release-wrong-handle':f=>f.values.supervisor.hostPolicy.Release.Handle='0x0000000000009999','host-close-failed-with-success-flags':f=>f.values.supervisor.hostEvidence.waitDuplicateClose.result=false,
    'host-creation-not-hidden':f=>f.values.supervisor.hostEvidence.calls[0].hidden=false,'host-creation-not-suspended':f=>f.values.supervisor.hostEvidence.calls[0].suspended=false,'host-creation-debug-flag':f=>f.values.supervisor.hostEvidence.calls[0].debugFlags=true,'host-creation-wrong-cwd':f=>f.values.supervisor.hostEvidence.calls[0].cwd='C:\\other','host-duplicate-alias':f=>f.values.supervisor.hostEvidence.calls[1].activeAlias=true,'host-duplicate-inherited':f=>f.values.supervisor.hostEvidence.calls[1].inherit=true,'host-raw-times-failed':f=>f.values.supervisor.hostEvidence.calls[3].call.Result=false,'host-raw-thread-wrong-pid':f=>f.values.supervisor.hostEvidence.calls[7].pid++,'host-resume-wrong-previous-count':f=>f.values.supervisor.hostEvidence.calls[11].previous=0,
    'self-close-early':f=>f.values.start.provenance.selfCapture.close.state='NATIVE_CLOSE_SUCCEEDED','self-pseudo-handle-not-duplicated':f=>f.values.start.provenance.selfCapture.calls[0].produced='0xffffffffffffffff','self-actual-image-pin-wrong':f=>f.values.start.provenance.selfCapture.calls[4].sha256='f'.repeat(64),'self-native-generation-wrong':f=>f.values.end.self.calls[2].createdFileTimeHex='0x0000000000009999','self-end-close-failed':f=>f.values.end.self.close.result=false,'self-end-release-wrong-context-handle':f=>f.values.end.selfRelease.Handle='0x0000000000009999','self-end-requires-exit':f=>f.values.end.hostExitRequired=true,'self-end-error-sticky':f=>f.values.end.entryErrors.push('failed'),
    'launch-claims-already-resumed':f=>f.values.launch.resumed=true,'launch-original-body-hash-mismatch':f=>f.values.start.provenance.supervisorHostLaunchSha256='f'.repeat(64),'report-provenance-not-original-start':f=>f.values.report.provenance.actualHostCommandLine+=' changed','actual-host-argv-wrong':f=>f.values.start.provenance.actualHostCommandLine+=' changed','expected-boundary-omitted':f=>delete f.expected.boundary,'reservation-same-size-wrong-bytes':f=>f.original.markers.get('attempt.marker')[0]=120,'reservation-marker-missing':f=>f.original.markers.delete('host-entry.marker')
  };for(const [name,change] of Object.entries(cases))negative(name,change);
  const f=makeProvenanceFixture();f.original.configBytes=Buffer.from('{"Schema":1,"Schema":1}');let caught=false;try{reconstructConfig(f.original.configBytes);}catch{caught=true;}yes('duplicate-config-key-before-deserialize',caught);rejects++;
}catch(e){error=e.stack;}
const files=Object.fromEntries(['check-trial-provenance.mjs','provenance-fixture-r1.mjs','test-trial-provenance-r1.mjs','strict-evidence-json.mjs','provenance-proof-r3/managed-fingerprint-reference.json'].map(n=>[n,digest(fs.readFileSync(path.join(root,n)))]));for(const name of Object.keys(files)){const source=path.join(root,name),copy=path.join(root,'provenance-proof-r3',path.basename(name)+'.source');if(fs.existsSync(copy))throw new Error('Proof snapshot identity used');fs.copyFileSync(source,copy);}
fs.writeFileSync(out,JSON.stringify({at:new Date().toISOString(),verdict:error?'FAIL':'PASS',scope:'VIRTUAL_CONFIG_JOURNAL_HOST_COMPONENT_ONLY',completeCellAcceptance:false,checks,accepts,rejects,error,files,nativeCalls:0,actualControlAttempt:false},null,2),{flag:'wx'});console.log(JSON.stringify({verdict:error?'FAIL':'PASS',checks:checks.length,accepts,rejects,error,artifact:out}));if(error)process.exitCode=1;
