{
  "name": "laughing-waffle-proto",
  "version": "1.0.0",
  "description": "Sparse prototype fork for Civilization Survivor core-system rework",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "start": "serve",
    "build": "node scripts/build-pages.mjs",
    "check:build": "node scripts/build-pages.mjs",
    "test": "npm run test:world && npm run test:detailed-settlements && npm run test:vassal-life-map && npm run test:debug-config && npm run test:map-lab && npm run test:detailed-replay",
    "verify": "npm run check:architecture && npm run check:source && npm run build && npm test",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:source": "node scripts/check-source-reachability.mjs",
    "test:world": "node src/model/tests/world-state.js",
    "test:map-lab": "node src/model/tests/map-lab-draft.js",
    "test:detailed-settlements": "node src/model/tests/detailed-settlements.js",
    "test:vassal-life-map": "node src/model/tests/vassal-life-map.js",
    "test:detailed-replay": "node src/model/tests/detailed-replay.js",
    "test:debug-config": "node src/model/tests/debug-game-config.js",
    "probe:settlement": "node scripts/settlement-browser-probe.mjs",
    "probe:settlement:quiet": "node scripts/settlement-browser-probe.mjs",
    "probe:settlement:verbose": "node scripts/settlement-browser-probe.mjs --verbose",
    "probe:map-lab": "node scripts/map-lab-browser-probe.mjs"
  },
  "keywords": [
    "html",
    "css"
  ],
  "author": "Ives van Hoorne",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.9",
    "playwright": "^1.59.1",
    "serve": "11.2.0"
  }
}
