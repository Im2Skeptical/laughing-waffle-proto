{
  "name": "laughing-waffle-proto",
  "version": "1.0.0",
  "description": "Sparse prototype fork for Civilization Survivor core-system rework",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "start": "serve",
    "prototype:vassal": "serve . --listen 4173",
    "preview:cards": "node scripts/preview-cards.mjs",
    "preview:vassals": "node scripts/preview-vassals.mjs",
    "preview:structures": "node scripts/preview-structures.mjs",
    "preview:keywords": "node scripts/preview-keywords.mjs",
    "build": "node scripts/build-pages.mjs",
    "build:sprites": "node scripts/build-sprite-sheets.mjs",
    "check:assets": "node scripts/check-asset-manifest.mjs",
    "check:build": "node scripts/build-pages.mjs",
    "test": "npm run test:save-recovery && npm run test:world && npm run test:detailed-settlements && npm run test:vassal-life-map && npm run test:debug-config && npm run test:map-lab && npm run test:detailed-replay && npm run test:invariants && npm run test:presentation && npm run test:card-review",
    "test:card-review": "node scripts/card-review-test.mjs",
    "test:save-recovery": "node scripts/save-recovery-test.mjs && node scripts/save-indexeddb-test.mjs && node scripts/save-load-worker-test.mjs",
    "test:presentation": "node scripts/region-map-camera-test.mjs && node scripts/presentation-time-test.mjs && node scripts/forecast-worker-service-test.mjs && node scripts/node-resolution-diagnostics-test.mjs && node scripts/new-game-opening-test.mjs && node scripts/game-display-mode-test.mjs && node scripts/life-map-interaction-test.mjs && node scripts/life-decision-test.mjs",
    "probe:civilization": "node scripts/civilization-browser-probe.mjs",
    "probe:development-lab": "node scripts/development-lab-browser-probe.mjs",
    "probe:prototypes": "node scripts/prototype-workbenches-browser-probe.mjs",
    "probe:timegraph-alignment": "node scripts/timegraph-alignment-browser-probe.mjs",
    "probe:chronicle": "node scripts/chronicle-browser-probe.mjs",
    "probe:settlement-draft": "node scripts/settlement-draft-browser-probe.mjs",
    "verify": "npm run check:docs && npm run check:architecture && npm run check:source && npm run check:assets && npm run build && npm test",
    "check:docs": "node scripts/check-docs.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:architecture:fixtures": "node scripts/check-architecture.mjs --fixtures",
    "check:source": "node scripts/check-source-reachability.mjs",
    "test:world": "node src/model/tests/world-state.js",
    "test:map-lab": "node src/model/tests/map-lab-draft.js",
    "test:detailed-settlements": "node src/model/tests/detailed-settlements.js",
    "test:vassal-life-map": "node src/model/tests/vassal-life-map.js",
    "test:detailed-replay": "node src/model/tests/detailed-replay.js",
    "test:invariants": "node src/model/tests/engine-invariants.js",
    "test:debug-config": "node src/model/tests/debug-game-config.js",
    "probe:settlement": "node scripts/settlement-browser-probe.mjs",
    "test:region-map-camera": "node scripts/region-map-camera-test.mjs",
    "probe:region-map": "node scripts/region-map-browser-probe.mjs",
    "probe:life-map": "node scripts/life-map-interaction-browser-probe.mjs",
    "probe:recap-input": "node scripts/node-recap-input-performance-probe.mjs",
    "probe:navigation": "node scripts/navigation-browser-probe.mjs",
    "probe:settlement:quiet": "node scripts/settlement-browser-probe.mjs",
    "probe:settlement:verbose": "node scripts/settlement-browser-probe.mjs --verbose",
    "probe:game-menu": "node scripts/game-menu-browser-probe.mjs",
    "probe:map-lab": "node scripts/map-lab-browser-probe.mjs",
    "test:differential": "node scripts/differential-regression.mjs"
  },
  "keywords": [
    "html",
    "css"
  ],
  "author": "Ives van Hoorne",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.9",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.59.1",
    "serve": "11.2.0"
  }
}
